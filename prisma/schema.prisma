generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // pooled, for the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct, for prisma db push
}

model Plan {
  id         String   @id @default(cuid())
  goal       String
  background String
  timeline   String
  title      String
  summary    String
  isDemo     Boolean  @default(false)
  sessionId  String?
  createdAt  DateTime @default(now())
  modules    Module[]
}

// One row per model-backed API call; daily caps count these.
model Usage {
  id        String   @id @default(cuid())
  kind      String // "plan" | "lesson" | "quiz" | "grade"
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model Module {
  id        String   @id @default(cuid())
  planId    String
  order     Int
  title     String
  objective String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id        String     @id @default(cuid())
  moduleId  String
  order     Int
  title     String
  objective String
  content   String?
  videos    String? // JSON: CuratedVideo[]
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz      Quiz?
  dives     DeepDive[]
}

// Cached on-demand deep dives: one per (lesson, normalized selection).
model DeepDive {
  id           String   @id @default(cuid())
  lessonId     String
  selectionKey String // normalized selection text, cache key
  selection    String // as highlighted
  content      String // markdown, may embed a ```viz fenced block
  createdAt    DateTime @default(now())
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, selectionKey])
}

model Quiz {
  id        String     @id @default(cuid())
  lessonId  String     @unique
  lesson    Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id           String    @id @default(cuid())
  quizId       String
  order        Int
  kind         String // "multiple_choice" | "free_response"
  prompt       String
  options      String? // JSON: string[] for multiple choice
  correctIndex Int?
  rubric       String? // grading rubric for free response
  quiz         Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attempts     Attempt[]
}

model Attempt {
  id         String   @id @default(cuid())
  questionId String
  answer     String
  score      Int
  maxScore   Int
  feedback   String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
